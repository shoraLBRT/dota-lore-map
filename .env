# Настройки сборки, которые видит страница (Vite: только VITE_*). Значения публичные — их видно в коде страницы.
# Переопределить локально — .env.local (в .gitignore). ARCHITECTURE A16, feedback-worker/README.md.

# Адрес функции отзыва (feedback-worker, #75). Пусто — отзыв уходит через форму issue на GitHub (#73).
VITE_FEEDBACK_URL=https://dota-lore-map-feedback.subshora.workers.dev/
# Публичный ключ сайта Cloudflare Turnstile (общий с Transliterator виджет на shoralbrt.github.io).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFp65dl16C0BeXfW
